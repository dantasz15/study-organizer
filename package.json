{
  "name": "study-organizer",
  "version": "2.0.0",
  "description": "CLI para organização de estudos com frases motivacionais via API",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit --forceExit",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest tests/integration --forceExit",
    "lint": "eslint src/ tests/"
  },
  "dependencies": {
    "node-fetch": "^3.3.2",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-fetch-mock": "^3.0.3"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [".js"],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "author": "Gabriel Henrique Rodrigues Dantas",
  "license": "MIT"
}
